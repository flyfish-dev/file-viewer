{
  "name": "@file-viewer/web-full",
  "version": "2.3.7",
  "private": false,
  "type": "module",
  "description": "Full Vanilla JS/Web Component package with preset-all; complete dist includes assets, while npm builds use deployment-base/file-viewer or the included copy CLI.",
  "keywords": [
    "file-viewer",
    "document-preview",
    "vanilla-js",
    "web-component",
    "full-preset",
    "office-preview",
    "cad-viewer",
    "document-viewer",
    "file-preview",
    "self-hosted"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "Yu Wang",
    "email": "admin@flyfish.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyfish-dev/file-viewer-web-full.git",
    "directory": "packages/components/web-full"
  },
  "homepage": "https://doc.file-viewer.app/",
  "bugs": {
    "url": "https://github.com/flyfish-dev/file-viewer-web-full/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://dev.flyfish.group/donate?source=npm"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "file-viewer-copy-assets": "./scripts/copy-assets.mjs"
  },
  "unpkg": "./dist/flyfish-file-viewer-web-full.iife.js",
  "jsdelivr": "./dist/flyfish-file-viewer-web-full.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "scripts/copy-assets.mjs",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && node scripts/build-iife.mjs",
    "type-check": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@file-viewer/core": "workspace:2.3.0",
    "@file-viewer/preset-all": "workspace:2.3.7",
    "@file-viewer/renderer-3d": "workspace:2.3.0",
    "@file-viewer/renderer-archive": "workspace:2.3.0",
    "@file-viewer/renderer-cad": "workspace:2.3.0",
    "@file-viewer/renderer-data": "workspace:2.3.0",
    "@file-viewer/renderer-drawing": "workspace:2.3.0",
    "@file-viewer/renderer-epub": "workspace:2.3.0",
    "@file-viewer/renderer-eda": "workspace:2.3.0",
    "@file-viewer/renderer-email": "workspace:2.3.0",
    "@file-viewer/renderer-geo": "workspace:2.3.0",
    "@file-viewer/renderer-image": "workspace:2.3.1",
    "@file-viewer/renderer-media": "workspace:2.3.0",
    "@file-viewer/renderer-mindmap": "workspace:2.3.0",
    "@file-viewer/renderer-ofd": "workspace:2.3.0",
    "@file-viewer/renderer-pdf": "workspace:2.3.1",
    "@file-viewer/renderer-presentation": "workspace:2.3.1",
    "@file-viewer/renderer-spreadsheet": "workspace:2.3.2",
    "@file-viewer/renderer-text": "workspace:2.3.0",
    "@file-viewer/renderer-typst": "workspace:2.3.0",
    "@file-viewer/renderer-word": "workspace:2.3.2",
    "@file-viewer/web": "workspace:2.3.0",
    "@file-viewer/renderer-hangul": "workspace:2.3.0",
    "@file-viewer/renderer-iwork": "workspace:2.3.1",
    "@file-viewer/renderer-wordperfect": "workspace:2.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "license": "Apache-2.0"
}
