{
  "name": "@file-viewer/capability-streaming-media",
  "version": "3.0.0",
  "private": false,
  "type": "module",
  "description": "Opt-in HLS fallback for File Viewer media playback.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyfish-dev/file-viewer.git",
    "directory": "packages/capabilities/streaming-media"
  },
  "homepage": "https://doc.file-viewer.app/guide/on-demand-renderers",
  "bugs": {
    "url": "https://github.com/flyfish-dev/file-viewer/issues"
  },
  "main": "./dist/index.js",
