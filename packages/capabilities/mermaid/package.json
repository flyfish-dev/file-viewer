{
  "name": "@file-viewer/capability-mermaid",
  "version": "3.1.2",
  "private": false,
  "type": "module",
  "description": "Opt-in Mermaid rendering for Markdown in File Viewer.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyfish-dev/file-viewer.git",
    "directory": "packages/capabilities/mermaid"
  },
  "homepage": "https://doc.file-viewer.app/guide/on-demand-renderers",
  "bugs": {
    "url": "https://github.com/flyfish-dev/file-viewer/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "file-viewer.capability.json",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && node scripts/build-runtime.mjs",
    "type-check": "tsc -b tsconfig.json",
    "verify:packed-browser": "pnpm --filter @file-viewer/core --filter @file-viewer/renderer-text --filter @file-viewer/renderer-drawing build && pnpm build && node scripts/verify-packed-browser.mjs"
  },
  "dependencies": {
    "@file-viewer/renderer-text": "workspace:3.1.2"
  },
  "devDependencies": {
    "mermaid": "11.17.2",
    "typescript": "^6.0.3",
    "vite": "8.3.0"
  },
  "fileViewer": {
    "capabilityManifest": "./file-viewer.capability.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "Apache-2.0"
}
