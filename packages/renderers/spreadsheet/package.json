{
  "name": "@file-viewer/renderer-spreadsheet",
  "version": "3.0.0",
  "private": false,
  "type": "module",
  "description": "Standalone spreadsheet renderer plugin for File Viewer powered by styled-exceljs and e-virt-table.",
  "keywords": [
    "file-viewer",
    "renderer",
    "spreadsheet",
    "excel",
    "xlsx",
    "xls",
    "csv",
    "tsv",
    "ods",
    "document-preview",
    "document-viewer",
    "file-preview",
    "self-hosted",
    "office-viewer"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "Yu Wang",
    "email": "admin@flyfish.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyfish-dev/file-viewer.git",
    "directory": "packages/renderers/spreadsheet"
  },
  "homepage": "https://doc.file-viewer.app/guide/on-demand-renderers",
  "bugs": {
    "url": "https://github.com/flyfish-dev/file-viewer/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://dev.flyfish.group/donate?source=npm"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker/sheetjs": {
      "types": "./dist/spreadsheet/worker/sheetjs/index.d.ts",
      "import": "./dist/spreadsheet/worker/sheetjs/index.js",
      "default": "./dist/spreadsheet/worker/sheetjs/index.js"
    },
    "./worker/sheetjs/sheet.worker": {
      "types": "./dist/spreadsheet/worker/sheetjs/sheet.worker.d.ts",
      "import": "./dist/spreadsheet/worker/sheetjs/sheet.worker.js",
      "default": "./dist/spreadsheet/worker/sheetjs/sheet.worker.js"
    },
    "./worker/sheet.worker.js": "./dist/worker/sheet.worker.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "file-viewer.capability.json",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json --force && node scripts/build-worker.mjs",
    "type-check": "tsc -b tsconfig.json",
    "verify:github-175": "pnpm build && node scripts/verify-github-175.mjs",
    "verify:github-178": "pnpm --filter @file-viewer/core build && pnpm build && npm exec --yes --package playwright@1.61.1 -- node scripts/verify-github-178.mjs",
    "verify:github-234": "pnpm --filter @file-viewer/core build && pnpm build && node scripts/verify-github-234.mjs"
  },
  "dependencies": {
    "@file-viewer/core": "workspace:3.0.0",
    "@xmldom/xmldom": "^0.9.10",
    "e-virt-table": "1.3.26",
    "jszip": "^3.10.1",
    "styled-exceljs": "0.21.4",
    "tinycolor2": "^1.6.0",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@types/tinycolor2": "^1.4.6",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  },
  "fileViewer": {
    "capabilityManifest": "./file-viewer.capability.json"
  },
  "license": "Apache-2.0"
}
