{
  "name": "@file-viewer/renderer-3d",
  "version": "3.1.2",
  "private": false,
  "type": "module",
  "description": "Standalone 3D model renderer plugin for File Viewer powered by Three.js loaders and OrbitControls.",
  "keywords": [
    "file-viewer",
    "renderer",
    "3d",
    "three",
    "gltf",
    "glb",
    "stl",
    "obj",
    "document-preview",
    "document-viewer",
    "file-preview",
    "self-hosted"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "Yu Wang",
    "email": "admin@flyfish.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyfish-dev/file-viewer.git",
    "directory": "packages/renderers/3d"
  },
  "homepage": "https://doc.file-viewer.app/guide/on-demand-renderers",
  "bugs": {
    "url": "https://github.com/flyfish-dev/file-viewer/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://dev.flyfish.group/donate?source=npm"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./ifc": {
      "types": "./dist/ifc.d.ts",
      "import": "./dist/ifc.js",
      "default": "./dist/ifc.js"
    },
    "./geo3d": {
      "types": "./dist/geo3d.d.ts",
      "import": "./dist/geo3d.js",
      "default": "./dist/geo3d.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE",
    "bin",
    "IFC.md",
    "licenses",
    "GEO3D.md",
    "GEO3D_THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && node scripts/build-geo3d-point-adapters.mjs && node scripts/build-geo3d-raster-adapters.mjs && node scripts/verify-geo3d-material-compatibility.mjs",
    "type-check": "tsc -b tsconfig.json",
    "verify:ifc": "node scripts/verify-ifc-entry.mjs && node --test scripts/ifc-settings.test.mjs",
    "verify:ifc-browser": "node scripts/verify-ifc-browser.mjs",
    "verify:geo3d": "node scripts/verify-geo3d-entry.mjs && node scripts/verify-geo3d-types.mjs && node --test scripts/geo3d-inputs.test.mjs scripts/geo3d-owned-workers.test.mjs scripts/geo3d-raster-workers.test.mjs scripts/geo3d-raster-cache.test.mjs scripts/geo3d-point-lifecycle.test.mjs scripts/geo3d-hooks.test.mjs scripts/geo3d-point-material.test.mjs scripts/geo3d-memory-fixtures.test.mjs",
    "verify:geo3d-browser": "node scripts/verify-geo3d-browser.mjs",
    "verify:geo3d-native-browser": "node scripts/verify-geo3d-native-browser.mjs"
  },
  "dependencies": {
    "@file-viewer/core": "workspace:3.1.2",
    "@file-viewer/geometry-engine": "workspace:3.1.2",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "typescript": "^6.0.3",
    "@thatopen/components": "3.4.8",
    "@thatopen/fragments": "3.4.7",
    "web-ifc": "0.0.77",
    "esbuild": "^0.28.2",
    "@giro3d/giro3d": "2.0.4",
    "jszip": "3.10.2"
  },
  "license": "Apache-2.0",
  "bin": {
    "file-viewer-ifc-assets": "./bin/copy-ifc-assets.mjs",
    "file-viewer-geo3d-assets": "./bin/copy-geo3d-assets.mjs"
  },
  "peerDependencies": {
    "@thatopen/components": "3.4.8",
    "@thatopen/fragments": "3.4.7",
    "web-ifc": "0.0.77",
    "esbuild": "^0.28.2",
    "@giro3d/giro3d": "2.0.4",
    "jszip": "3.10.2"
  },
  "peerDependenciesMeta": {
    "@thatopen/components": {
      "optional": true
    },
    "@thatopen/fragments": {
      "optional": true
    },
    "web-ifc": {
      "optional": true
    },
    "esbuild": {
      "optional": true
    },
    "@giro3d/giro3d": {
      "optional": true
    },
    "jszip": {
      "optional": true
    }
  }
}
