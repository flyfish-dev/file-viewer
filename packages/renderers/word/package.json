{
  "name": "@file-viewer/renderer-word",
  "version": "3.0.1",
  "private": false,
  "type": "module",
  "description": "Standalone DOCX, DOC, and OpenDocument renderer for File Viewer; RTF parsing is an explicit opt-in capability.",
  "keywords": [
    "file-viewer",
    "renderer",
    "word",
    "docx",
    "doc",
    "rtf",
    "odt",
    "document-preview",
    "document-viewer",
    "file-preview",
    "self-hosted",
    "office-viewer"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "Yu Wang",
    "email": "admin@flyfish.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyfish-dev/file-viewer.git",
    "directory": "packages/renderers/word"
  },
  "homepage": "https://doc.file-viewer.app/guide/on-demand-renderers",
  "bugs": {
    "url": "https://github.com/flyfish-dev/file-viewer/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://dev.flyfish.group/donate?source=npm"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "file-viewer.capability.json",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && node --test test/*.test.mjs",
    "type-check": "tsc -b tsconfig.json",
    "verify:rtf-security": "npm exec --yes --package playwright@1.61.1 -- node scripts/verify-rtf-link-policy.mjs"
  },
  "dependencies": {
    "@file-viewer/core": "workspace:3.0.1",
    "@file-viewer/doc": "workspace:3.0.1",
    "@file-viewer/docx": "0.3.28",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "rtf.js": "^3.0.9",
    "jsdom": "^27.4.0",
    "typescript": "^6.0.3"
  },
  "fileViewer": {
    "capabilityManifest": "./file-viewer.capability.json"
  },
  "license": "Apache-2.0"
}
