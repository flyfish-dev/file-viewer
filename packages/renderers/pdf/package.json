{
  "name": "@file-viewer/renderer-pdf",
  "version": "3.0.2",
  "private": false,
  "type": "module",
  "description": "Standalone PDF renderer plugin for File Viewer powered by PDF.js.",
  "keywords": [
    "file-viewer",
    "renderer",
    "pdf",
    "pdfjs",
    "document-preview",
    "document-viewer",
    "file-preview",
    "self-hosted",
    "pdf-viewer"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "Yu Wang",
    "email": "admin@flyfish.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyfish-dev/file-viewer.git",
    "directory": "packages/renderers/pdf"
  },
  "homepage": "https://doc.file-viewer.app/guide/on-demand-renderers",
  "bugs": {
    "url": "https://github.com/flyfish-dev/file-viewer/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://dev.flyfish.group/donate?source=npm"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./identity-font-repair": {
      "types": "./dist/pdfIdentityFontRepair.d.ts",
      "import": "./dist/pdfIdentityFontRepair.js",
      "default": "./dist/pdfIdentityFontRepair.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "file-viewer.capability.json",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && node scripts/stage-pdfjs-runtime.mjs",
    "type-check": "tsc -b tsconfig.json",
    "verify:pdfjs-runtime": "node scripts/stage-pdfjs-runtime.mjs --check",
    "prepack": "node scripts/stage-pdfjs-runtime.mjs --check"
  },
  "dependencies": {
    "@file-viewer/core": "workspace:3.0.2"
  },
  "peerDependencies": {
    "pdf-lib": "1.17.1"
  },
  "peerDependenciesMeta": {
    "pdf-lib": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.624",
    "typescript": "^6.0.3"
  },
  "fileViewer": {
    "capabilityManifest": "./file-viewer.capability.json"
  },
  "license": "Apache-2.0"
}
