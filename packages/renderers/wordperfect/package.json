{
  "name": "@file-viewer/renderer-wordperfect",
  "version": "2.3.0",
  "private": false,
  "type": "module",
  "description": "Signature-routed WordPerfect renderer plugin for File Viewer with a libwpd WASM integration boundary.",
  "keywords": [
    "file-viewer",
    "renderer",
    "wordperfect",
    "wpd",
    "wp5",
    "wp6",
    "libwpd",
    "wasm",
    "self-hosted"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "Yu Wang",
    "email": "admin@flyfish.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyfish-dev/file-viewer.git",
    "directory": "packages/renderers/wordperfect"
  },
  "homepage": "https://doc.file-viewer.app/guide/on-demand-renderers",
  "bugs": {
    "url": "https://github.com/flyfish-dev/file-viewer/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://dev.flyfish.group/donate?source=npm"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker/wordperfect.worker.js": "./dist/wordperfect.worker.js",
    "./worker/libwpd.mjs": "./dist/libwpd.mjs",
    "./worker/libwpd.wasm": "./dist/libwpd.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "vendor/libwpd-src",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json --force && node scripts/build-worker.mjs",
    "build:wasm": "node scripts/build-libwpd-wasm.mjs",
    "type-check": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@file-viewer/core": "workspace:2.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  },
  "license": "Apache-2.0"
}
