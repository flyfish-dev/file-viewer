{
  "name": "@file-viewer/renderer-data",
  "version": "3.0.3",
  "private": false,
  "type": "module",
  "description": "Standalone data asset renderer plugin for File Viewer with PSD, SQLite, Parquet, Avro, WASM, font, AI/EPS, and WebArchive previews.",
  "keywords": [
    "file-viewer",
    "renderer",
    "data",
    "sqlite",
    "parquet",
    "avro",
    "psd",
    "wasm",
    "document-preview",
    "document-viewer",
    "file-preview",
    "self-hosted"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "Yu Wang",
    "email": "admin@flyfish.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyfish-dev/file-viewer.git",
    "directory": "packages/renderers/data"
  },
  "homepage": "https://doc.file-viewer.app/guide/on-demand-renderers",
  "bugs": {
    "url": "https://github.com/flyfish-dev/file-viewer/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://dev.flyfish.group/donate?source=npm"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && node scripts/build-browser.mjs",
    "type-check": "tsc -b tsconfig.json",
    "verify:avro-browser": "node scripts/verify-avro-browser.mjs"
  },
  "dependencies": {
    "@file-viewer/core": "workspace:3.0.3",
    "ag-psd": "^30.1.1",
    "avsc": "^5.7.9",
    "hyparquet": "^1.30.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "assert": "2.1.0",
    "browserify-zlib": "0.2.0",
    "buffer": "6.0.3",
    "events": "3.3.0",
    "path-browserify": "1.0.1",
    "process": "0.11.10",
    "stream-browserify": "3.0.0",
    "string_decoder": "1.3.0",
    "util": "0.12.5",
    "esbuild": "0.28.2",
    "typescript": "^6.0.3"
  },
  "license": "Apache-2.0"
}
