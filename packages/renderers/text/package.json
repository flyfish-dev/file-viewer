{
  "name": "@file-viewer/renderer-text",
  "version": "3.0.0",
  "private": false,
  "type": "module",
  "description": "Standalone code, text, and Markdown renderer for File Viewer; Mermaid, patch diff, and Git bundle tools are explicit opt-in capabilities.",
  "keywords": [
    "file-viewer",
    "renderer",
    "text",
    "code",
    "markdown",
    "patch",
    "git-bundle",
    "highlight.js",
    "document-preview",
    "document-viewer",
    "file-preview",
    "self-hosted"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "Yu Wang",
    "email": "admin@flyfish.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyfish-dev/file-viewer.git",
    "directory": "packages/renderers/text"
  },
  "homepage": "https://doc.file-viewer.app/guide/on-demand-renderers",
  "bugs": {
    "url": "https://github.com/flyfish-dev/file-viewer/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://dev.flyfish.group/donate?source=npm"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "file-viewer.capability.json",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && node --test test/*.test.mjs",
    "type-check": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@file-viewer/core": "workspace:3.0.0",
    "@prettier/plugin-xml": "3.4.2",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.5",
    "prettier": "3.8.3"
  },
  "devDependencies": {
    "diff2html": "^3.4.56",
    "mermaid": "^11.16.1",
    "pako": "^3.0.1",
    "jsdom": "^27.4.0",
    "typescript": "^6.0.3"
  },
  "fileViewer": {
    "capabilityManifest": "./file-viewer.capability.json"
  },
  "license": "Apache-2.0"
}
