{
  "name": "@file-viewer/renderer-text",
  "version": "3.1.2",
  "private": false,
  "type": "module",
  "description": "Standalone code, text, and Markdown renderer for File Viewer; Mermaid, patch diff, and Git bundle tools are explicit opt-in capabilities.",
  "keywords": [
    "file-viewer",
    "renderer",
    "text",
    "code",
    "markdown",
    "patch",
    "git-bundle",
    "highlight.js",
    "document-preview",
    "document-viewer",
    "file-preview",
    "self-hosted"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "Yu Wang",
    "email": "admin@flyfish.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyfish-dev/file-viewer.git",
    "directory": "packages/renderers/text"
  },
  "homepage": "https://doc.file-viewer.app/guide/on-demand-renderers",
  "bugs": {
    "url": "https://github.com/flyfish-dev/file-viewer/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://dev.flyfish.group/donate?source=npm"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./xml-profiles": {
      "types": "./dist/xml-profiles.d.ts",
      "import": "./dist/xml-profiles.js",
      "default": "./dist/xml-profiles.js"
    },
    "./xml-profile-assets": "./bin/copy-xml-profile-assets.mjs"
  },
  "bin": {
    "file-viewer-xml-assets": "./bin/copy-xml-profile-assets.mjs"
  },
  "files": [
    "dist",
    "file-viewer.capability.json",
    "README.md",
    "README.en.md",
    "LICENSE",
    "bin/copy-xml-profile-assets.mjs",
    "licenses/xml-profiles"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && node --test test/*.test.mjs",
    "type-check": "tsc -b tsconfig.json",
    "test:xml-profiles:browser": "node test/issue-305-xml-profiles.browser.mjs"
  },
  "dependencies": {
    "@file-viewer/core": "workspace:3.1.2",
    "@prettier/plugin-xml": "3.4.2",
    "dompurify": "3.4.15",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.12",
    "prettier": "3.9.6"
  },
  "devDependencies": {
    "diff2html": "^3.4.56",
    "mermaid": "^12.0.0",
    "pako": "^2.2.0",
    "jsdom": "^27.4.0",
    "typescript": "^6.0.3",
    "xmllint-wasm": "5.3.0",
    "xslt-polyfill": "1.0.29"
  },
  "peerDependencies": {
    "xmllint-wasm": "5.3.0",
    "xslt-polyfill": "1.0.29"
  },
  "peerDependenciesMeta": {
    "xmllint-wasm": {
      "optional": true
    },
    "xslt-polyfill": {
      "optional": true
    }
  },
  "fileViewer": {
    "capabilityManifest": "./file-viewer.capability.json"
  },
  "license": "Apache-2.0"
}
