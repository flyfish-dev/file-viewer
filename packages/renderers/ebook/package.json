{
  "name": "@file-viewer/renderer-epub",
  "version": "2.4.0",
  "private": false,
  "type": "module",
  "description": "Standalone EPUB, FictionBook 2 and UMD reader renderer plugin for File Viewer.",
  "keywords": [
    "file-viewer",
    "renderer",
    "epub",
    "umd",
    "fb2",
    "document-preview",
    "document-viewer",
    "file-preview",
    "self-hosted"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "Yu Wang",
    "email": "admin@flyfish.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyfish-dev/file-viewer.git",
    "directory": "packages/renderers/ebook"
  },
  "homepage": "https://doc.file-viewer.app/guide/on-demand-renderers",
  "bugs": {
    "url": "https://github.com/flyfish-dev/file-viewer/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://dev.flyfish.group/donate?source=npm"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json --force && node scripts/build-epub-engine.mjs",
    "type-check": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@file-viewer/core": "workspace:2.4.0",
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.9.10",
    "@types/pako": "^2.0.4",
    "epubjs": "0.3.93",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  },
  "license": "Apache-2.0"
}
