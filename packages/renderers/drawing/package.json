{
  "name": "@file-viewer/renderer-drawing",
  "version": "3.1.2",
  "private": false,
  "type": "module",
  "description": "Draw.io, Excalidraw, Mermaid, and PlantUML renderers for File Viewer, with an opt-in BPMN viewer.",
  "keywords": [
    "file-viewer",
    "renderer",
    "drawio",
    "excalidraw",
    "mermaid",
    "plantuml",
    "bpmn",
    "diagram",
    "document-preview",
    "document-viewer",
    "file-preview",
    "self-hosted"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "Yu Wang",
    "email": "admin@flyfish.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyfish-dev/file-viewer.git",
    "directory": "packages/renderers/drawing"
  },
  "homepage": "https://doc.file-viewer.app/guide/on-demand-renderers",
  "bugs": {
    "url": "https://github.com/flyfish-dev/file-viewer/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://dev.flyfish.group/donate?source=npm"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bpmn": {
      "types": "./dist/bpmn.d.ts",
      "import": "./dist/bpmn.js",
      "default": "./dist/bpmn.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "file-viewer.capability.json",
    "README.md",
    "README.en.md",
    "test/fixtures",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-bpmn-styles.mjs && tsc -b tsconfig.json",
    "type-check": "tsc -b tsconfig.json"
  },
  "fileViewer": {
    "capabilityManifest": "./file-viewer.capability.json"
  },
  "dependencies": {
    "@file-viewer/core": "workspace:3.1.2",
    "@panzoom/panzoom": "^4.6.2",
    "dompurify": "3.4.15",
    "mermaid": "^12.0.0",
    "plantuml-encoder": "^1.4.0",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "bpmn-js": "18.28.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "bpmn-js": "18.28.0"
  },
  "peerDependenciesMeta": {
    "bpmn-js": {
      "optional": true
    }
  },
  "license": "Apache-2.0"
}
