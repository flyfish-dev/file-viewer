{
  "name": "@file-viewer/pptx",
  "version": "3.3.1",
  "private": false,
  "type": "module",
  "description": "Native PPTX renderer extracted from File Viewer",
  "keywords": [
    "pptx",
    "powerpoint",
    "presentation",
    "file-viewer",
    "document-preview",
    "document-viewer",
    "file-preview",
    "self-hosted"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "Yu Wang",
    "email": "admin@flyfish.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyfish-dev/file-viewer.git",
    "directory": "packages/renderers/pptx"
  },
  "homepage": "https://doc.file-viewer.app/",
  "bugs": {
    "url": "https://github.com/flyfish-dev/file-viewer/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://dev.flyfish.group/donate?source=npm"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "default": "./dist/worker.js"
    },
    "./worker/pptx.worker.js": "./dist/worker/pptx.worker.js",
    "./styles.css": "./dist/styles/pptxjs.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE",
    "README.zh-CN.md"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -b tsconfig.json --force && node scripts/build-worker.mjs && node scripts/copy-assets.mjs && node scripts/fix-esm-extensions.mjs",
    "type-check": "tsc -b tsconfig.json",
    "verify:github-176": "node scripts/verify-github-176.mjs",
    "verify:github-268": "node scripts/verify-github-268.mjs && node scripts/verify-chart-families.mjs",
    "verify:github-268-browser": "node scripts/verify-github-268-browser.mjs",
    "verify:drawing-semantics": "node scripts/verify-drawing-semantics.mjs"
  },
  "dependencies": {
    "dingbat-to-unicode": "^1.0.1",
    "dompurify": "3.4.17",
    "jszip": "3.10.2",
    "tinycolor2": "^1.6.0",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "billboard.js": "4.1.3",
    "d3-format": "^3.1.2",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3",
    "@types/d3-format": "^3.0.4"
  },
  "license": "Apache-2.0"
}
