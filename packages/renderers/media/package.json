{
  "name": "@file-viewer/renderer-media",
  "version": "3.0.2",
  "private": false,
  "type": "module",
  "description": "Standalone native audio and video renderer for File Viewer; HLS fallback and MIDI inspection are explicit opt-in capabilities.",
  "keywords": [
    "file-viewer",
    "renderer",
    "audio",
    "video",
    "hls",
    "midi",
    "document-preview",
    "document-viewer",
    "file-preview",
    "self-hosted"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "Yu Wang",
    "email": "admin@flyfish.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyfish-dev/file-viewer.git",
    "directory": "packages/renderers/media"
  },
  "homepage": "https://doc.file-viewer.app/guide/on-demand-renderers",
  "bugs": {
    "url": "https://github.com/flyfish-dev/file-viewer/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://dev.flyfish.group/donate?source=npm"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "file-viewer.capability.json",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json && node scripts/copy-mp4v-assets.mjs",
    "type-check": "tsc -b tsconfig.json",
    "build:mp4v-decoder": "node scripts/build-mp4v-decoder.mjs",
    "verify:mp4v-boundary": "node scripts/verify-mp4v-boundary.mjs",
    "verify:mp4v-demo-dist": "npm exec --yes --package playwright@1.61.1 -- node scripts/verify-mp4v-demo-dist.mjs",
    "verify:mp4v-black-screen": "pnpm build && pnpm verify:mp4v-boundary && npm exec --yes --package playwright@1.61.1 -- node scripts/verify-mp4v-black-screen.mjs"
  },
  "dependencies": {
    "@file-viewer/core": "workspace:3.0.2"
  },
  "devDependencies": {
    "@tonejs/midi": "^2.0.28",
    "hls.js": "^1.6.16",
    "typescript": "^6.0.3"
  },
  "fileViewer": {
    "capabilityManifest": "./file-viewer.capability.json"
  },
  "license": "Apache-2.0"
}
