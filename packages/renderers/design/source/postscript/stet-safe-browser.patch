+    // WASM resources live in FileStore's virtual filesystem rather than the
+    // host filesystem.  Prefer those bytes and construct the Type 42 font
+    // directly; native builds retain the existing on-disk fallback.
+    let embedded = ctx.files.get_embedded_file(path_str.as_ref());
+    let ok = if let Some(data) = embedded {
+        stet_core::system_font_loader::load_ttf_from_data(ctx, data)
+    } else {
+        let path = std::path::Path::new(path_str.as_ref());
+        stet_core::system_font_loader::load_binary_font(ctx, path)
+    };
     ctx.o_stack.push(PsObject::bool(ok))?;
     Ok(())
 }
