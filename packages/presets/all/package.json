    "@file-viewer/renderer-epub": "workspace:3.0.2",
    "@file-viewer/renderer-eda": "workspace:3.0.2",
    "@file-viewer/renderer-email": "workspace:3.0.2",
    "@file-viewer/renderer-geo": "workspace:3.0.2",
    "@file-viewer/renderer-image": "workspace:3.0.2",
    "@file-viewer/renderer-media": "workspace:3.0.2",
    "@file-viewer/renderer-mindmap": "workspace:3.0.2",
    "@file-viewer/renderer-ofd": "workspace:3.0.2",
    "@file-viewer/renderer-pdf": "workspace:3.0.2",
    "@file-viewer/renderer-presentation": "workspace:3.0.2",
    "@file-viewer/renderer-ppt": "workspace:3.0.2",
    "@file-viewer/renderer-pptx": "workspace:3.0.2",
    "@file-viewer/renderer-spreadsheet": "workspace:3.0.2",
    "@file-viewer/renderer-text": "workspace:3.0.2",
    "@file-viewer/renderer-typst": "workspace:3.0.2",
    "@file-viewer/renderer-word": "workspace:3.0.2",
    "@file-viewer/renderer-hangul": "workspace:3.0.2",
    "@file-viewer/renderer-iwork": "workspace:3.0.2",
    "@file-viewer/renderer-wordperfect": "workspace:3.0.2",
    "@fontsource-variable/noto-sans-sc": "5.3.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
