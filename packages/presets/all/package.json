{
  "name": "@file-viewer/preset-all",
  "version": "3.0.2",
  "private": false,
  "type": "module",
  "description": "All renderer preset for File Viewer, preserving the full format matrix while renderer packages are split out.",
  "keywords": [
    "file-viewer",
    "renderer-preset",
    "document-preview",
    "on-demand-renderer",
    "document-viewer",
    "file-preview",
    "self-hosted"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": {
    "name": "Yu Wang",
    "email": "admin@flyfish.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyfish-dev/file-viewer.git",
    "directory": "packages/presets/all"
  },
  "homepage": "https://doc.file-viewer.app/guide/on-demand-renderers",
  "bugs": {
    "url": "https://github.com/flyfish-dev/file-viewer/issues"
  },
  "funding": {
    "type": "individual",
    "url": "https://dev.flyfish.group/donate?source=npm"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "compatibility-baseline.json",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "type-check": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@file-viewer/capability-drawio-official": "workspace:3.0.2",
    "@file-viewer/capability-pdf-identity-repair": "workspace:3.0.2",
    "@file-viewer/capability-pptx-charts": "workspace:3.0.2",
    "@file-viewer/capability-mermaid": "workspace:3.0.2",
    "@file-viewer/capability-midi": "workspace:3.0.2",
    "@file-viewer/capability-rtf": "workspace:3.0.2",
    "@file-viewer/capability-streaming-media": "workspace:3.0.2",
    "@file-viewer/capability-text-tools": "workspace:3.0.2",
    "@file-viewer/core": "workspace:3.0.2",
    "@file-viewer/renderer-3d": "workspace:3.0.2",
    "@file-viewer/renderer-archive": "workspace:3.0.2",
    "@file-viewer/renderer-cad": "workspace:3.0.2",
    "@file-viewer/renderer-chm": "workspace:3.0.2",
