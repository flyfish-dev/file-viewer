{
  "name": "create-file-viewer",
  "version": "3.0.0",
  "private": false,
  "type": "module",
  "description": "Create a runnable File Viewer project with a selected framework, version, profile, formats, and self-hosted assets.",
  "bin": {
    "create-file-viewer": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "fileViewer": {
    "executableOnly": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../build-support/ensure-node-bin.mjs packages/compat/create-file-viewer/dist/cli.js && node --test test/*.test.mjs",
    "type-check": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "verify:e2e": "node test/verify-bootstrap-e2e.mjs",
    "prepack": "tsc -p tsconfig.json && node ../../build-support/ensure-node-bin.mjs packages/compat/create-file-viewer/dist/cli.js"
  },
  "dependencies": {
    "@file-viewer/cli": "workspace:3.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "homepage": "https://file-viewer.app/en/cli/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyfish-dev/file-viewer.git",
    "directory": "packages/compat/create-file-viewer"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
