{
  "name": "@flyfish-group/file-viewer-demo",
  "version": "3.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-assets": "pnpm --dir ../.. --filter @file-viewer/core --filter @file-viewer/geometry-engine --filter @file-viewer/renderer-3d -r build && node scripts/stage-specialist-demo-fixtures.mjs && node ../../packages/renderers/text/bin/copy-xml-profile-assets.mjs public/file-viewer/xml && node ../../packages/renderers/3d/bin/copy-ifc-assets.mjs public/file-viewer/vendor/ifc",
    "dev": "pnpm prepare-assets && vite --host 127.0.0.1",
    "build": "pnpm prepare-assets && vue-tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "type-check": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@file-viewer/core": "workspace:3.1.2",
    "@file-viewer/preset-all": "workspace:3.1.2",
    "@file-viewer/renderer-3d": "workspace:3.1.2",
    "@file-viewer/renderer-binary": "workspace:3.1.2",
    "@file-viewer/renderer-design": "workspace:3.1.2",
    "@file-viewer/renderer-dicom": "workspace:3.1.2",
    "@file-viewer/renderer-drawing": "workspace:3.1.2",
    "@file-viewer/renderer-signature": "workspace:3.1.2",
    "@file-viewer/renderer-text": "workspace:3.1.2",
    "@file-viewer/web": "workspace:3.1.2",
    "@file-viewer/vue3": "workspace:3.1.2",
    "@thatopen/components": "3.4.8",
    "@thatopen/fragments": "3.4.7",
    "@lucide/vue": "^1.43.0",
    "bpmn-js": "18.31.0",
    "diff": "^9.0.0",
    "qs": "^6.16.0",
    "vue": "^3.5.42",
    "web-ifc": "0.0.77",
    "xmllint-wasm": "5.3.0",
    "xslt-polyfill": "1.0.31"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/qs": "^6.15.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/tsconfig": "^0.9.1",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "esbuild": "^0.28.2",
    "path-browserify": "^1.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "stream-browserify": "^3.0.0",
    "typescript": "^6.0.3",
    "vite": "8.3.3",
    "vue-tsc": "^3.3.4"
  }
}
