{
  "name": "@file-viewer/ppt",
  "version": "1.0.2",
  "description": "Pure TypeScript legacy PowerPoint .ppt parser and SVG viewer, implemented from Microsoft Open Specifications",
  "type": "module",
  "license": "Apache-2.0",
  "private": false,
  "repository": { "type": "git", "url": "git+https://github.com/flyfish-dev/pptjs.git" },
  "homepage": "https://doc.file-viewer.app/guide/on-demand-renderers",
  "bugs": { "url": "https://github.com/flyfish-dev/file-viewer/issues" },
  "author": { "name": "Flyfish", "email": "admin@flyfish.dev" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./parser": { "types": "./dist/ppt/parser.d.ts", "import": "./dist/ppt/parser.js" },
    "./worker": "./dist/worker.js",
    "./worker.mjs": "./dist/pptjs.worker.js",
    "./browser": "./dist/pptjs.browser.js",
    "./standalone": { "types": "./dist/index.d.ts", "import": "./dist/pptjs.mjs" },
    "./manifest.json": "./dist/manifest.json",
    "./LICENSE": "./LICENSE",
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE.md"],
  "sideEffects": ["./dist/worker.js", "./dist/pptjs.worker.js", "./dist/pptjs.browser.js"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/build.mjs --check",
    "test": "node --test test/*.test.mjs",
    "fixtures": "node scripts/make-fixtures.mjs && node scripts/make-playback-fixture.mjs",
    "bundle": "node scripts/bundle.mjs",
    "build:all": "npm run fixtures && npm run build && npm run bundle",
    "test:corpus": "node scripts/corpus.mjs",
    "test:large": "node scripts/validate-large.mjs",
    "spec:check": "node scripts/check-spec-coverage.mjs",
    "dev": "node scripts/serve.mjs",
    "verify": "node scripts/verify-release.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:consumers": "node scripts/verify-consumers.mjs",
    "test:package": "node scripts/check-package.mjs"
  },
  "devDependencies": { "typescript": "5.9.3", "playwright": "1.63.0", "vite": "8.3.5", "webpack": "5.106.1", "webpack-cli": "7.0.2" },
  "engines": { "node": ">=20" }
}
