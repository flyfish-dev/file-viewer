{
  "name": "@flyfish-group/file-viewer-open-source",
  "version": "2.3.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "description": "Browser-native, offline-first file preview components, renderers, presets, demos and documentation.",
  "scripts": {
    "dev": "pnpm --filter @flyfish-group/file-viewer-demo dev",
    "dev:components": "pnpm --filter @flyfish-group/file-viewer-component-demo dev",
    "site:dev": "pnpm --filter @flyfish-group/file-viewer-site dev",
    "site:build": "pnpm --filter @flyfish-group/file-viewer-site build",
    "site:preview": "pnpm --filter @flyfish-group/file-viewer-site preview",
    "build": "pnpm build:core && pnpm build:renderers && pnpm build:presets && pnpm build:components && pnpm build:tools && pnpm build:thumbnail && pnpm build:examples && pnpm build:demo",
    "build:demo": "pnpm --filter @flyfish-group/file-viewer-demo build",
    "build:component-demo": "pnpm --filter @flyfish-group/file-viewer-component-demo build",
    "build:pptx": "pnpm --filter @file-viewer/pptx build",
    "build:doc": "pnpm --filter @file-viewer/doc build",
    "build:core": "pnpm --filter @file-viewer/core build",
    "build:renderers": "pnpm --filter './packages/renderers/**' build",
    "build:presets": "pnpm --filter './packages/presets/**' build",
    "build:thumbnail": "pnpm --filter @file-viewer/thumbnail build",
    "build:components": "pnpm --filter './packages/components/**' build",
    "build:tools": "pnpm --filter file-viewer-copy-assets stage-assets && pnpm --filter './packages/tools/**' build",
    "build:examples": "pnpm --filter '@file-viewer/example-*' build",
    "type-check": "pnpm type-check:core && pnpm type-check:renderers && pnpm type-check:presets && pnpm type-check:thumbnail && pnpm type-check:components && pnpm type-check:tools && pnpm --filter @flyfish-group/file-viewer-demo type-check",
    "type-check:core": "pnpm --filter @file-viewer/core type-check",
    "type-check:thumbnail": "pnpm --filter @file-viewer/thumbnail type-check",
    "type-check:renderers": "pnpm --filter './packages/renderers/**' type-check",
    "type-check:presets": "pnpm --filter './packages/presets/**' type-check",
    "test:i18n": "node apps/viewer-demo/scripts/verify-japanese-i18n.mjs",
    "test:spreadsheet-github-178": "pnpm --filter @file-viewer/renderer-spreadsheet verify:github-178",
    "test:thumbnail": "pnpm --filter @file-viewer/thumbnail test",
    "test": "pnpm test:i18n && pnpm test:thumbnail",
    "type-check:components": "pnpm --filter @file-viewer/web type-check && pnpm --filter @file-viewer/react type-check && pnpm --filter @file-viewer/react-legacy type-check && pnpm --filter @file-viewer/vue3 type-check && pnpm --filter @file-viewer/vue2.7 type-check && pnpm --filter @file-viewer/vue2.6 type-check && pnpm --filter @file-viewer/jquery type-check && pnpm --filter @file-viewer/svelte type-check",
    "type-check:tools": "pnpm --filter './packages/tools/**' type-check",
    "docs:dev": "pnpm --filter @flyfish-group/file-viewer-docs dev",
    "docs:build": "pnpm --filter @flyfish-group/file-viewer-docs build",
    "docs:preview": "pnpm --filter @flyfish-group/file-viewer-docs preview",
    "verify:vue3-toolbar-browser": "node apps/component-demo/scripts/verify-vue3-toolbar-browser.mjs",
    "verify:renderer-sanitization": "pnpm --filter @file-viewer/pptx build && node apps/viewer-demo/scripts/verify-renderer-sanitization.mjs",
    "verify:presentation-entrypoints": "pnpm --filter @file-viewer/core build && pnpm --filter @file-viewer/pptx build && pnpm --filter @file-viewer/renderer-presentation build && pnpm --filter @file-viewer/vite-plugin build && node apps/viewer-demo/scripts/verify-presentation-entrypoints.mjs",
    "verify:presentation-registry-cold": "node apps/viewer-demo/scripts/verify-presentation-registry-cold.mjs",
    "verify:browser-smoke": "node apps/viewer-demo/scripts/public-smoke.mjs",
    "verify:pptx-slideshow": "npm exec --yes --package playwright -- node apps/viewer-demo/scripts/verify-pptx-slideshow.mjs",
    "verify:github-governance": "node --test .github/scripts/governance.test.mjs && node .github/scripts/verify-community-standards.mjs && prettier --config .github/prettier-governance.json --check '.github/**/*.{md,yml,mjs,json}' CONTRIBUTING.md SUPPORT.md"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "prettier": "3.8.3",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3"
  },
  "license": "Apache-2.0"
}
