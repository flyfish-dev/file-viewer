{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "contractId": "file-viewer-copy-assets-v2-public-contract",
  "compatibilityPolicy": {
    "legacyPackage": "file-viewer-copy-assets",
    "unifiedPackage": "@file-viewer/cli",
    "minimumLegacyNodeMajor": 18,
    "versionCoupling": "exact",
    "safeCorrectionsMayTightenLegacyBehavior": true
  },
  "entrypoints": {
    "legacy": {
      "bin": "file-viewer-copy-assets",
      "argvPrefix": []
    },
    "unified": {
      "bin": "file-viewer",
      "argvPrefix": ["assets"]
    },
    "unifiedLegacyAlias": {
      "bin": "file-viewer-copy-assets",
      "argvPrefix": []
    }
  },
  "fullPackages": [
    "@file-viewer/jquery-full",
    "@file-viewer/react-full",
    "@file-viewer/react-legacy-full",
    "@file-viewer/svelte-full",
    "@file-viewer/vue2.6-full",
    "@file-viewer/vue2.7-full",
    "@file-viewer/vue3-full",
    "@file-viewer/web-full"
  ],
  "fullPackagesWithExactLegacyDependency": [
    "@file-viewer/jquery-full",
    "@file-viewer/react-full",
    "@file-viewer/react-legacy-full",
    "@file-viewer/svelte-full",
    "@file-viewer/vue2.6-full",
    "@file-viewer/vue2.7-full",
    "@file-viewer/vue3-full"
  ],
  "arguments": {
    "positionalTarget": {
      "maximum": 1,
      "default": "public/file-viewer"
    },
    "flags": {
      "--clean": "request replacement of the dedicated target",
      "--confirm": "required together with --clean",
      "--no-clean": "deprecated no-op alias for the default merge mode",
      "--renderers <csv>": "copy a deterministic de-duplicated renderer asset subset",
      "-h, --help": "print help without writing project files",
      "-v, --version": "print the package version without writing project files"
    }
  },
  "environment": {
    "FILE_VIEWER_PUBLIC_DIR": "target override when no positional target is supplied",
    "FILE_VIEWER_SKIP_ASSET_COPY": {
      "truthyValues": ["1", "true"],
      "effect": "successful no-op"
    },
    "INIT_CWD": "base directory for the default public/file-viewer target",
    "precedence": [
      "positional target",
      "FILE_VIEWER_PUBLIC_DIR",
      "INIT_CWD/public/file-viewer",
      "process.cwd()/public/file-viewer"
    ]
  },
  "exitCodes": {
    "success": 0,
    "usageOrRuntimeError": 1
  },
  "output": {
    "runtimeManifest": "flyfish-viewer-assets.json",
    "distributionManifest": "flyfish-viewer-manifest.json",
    "legacySelectedManifest": "file-viewer-copy-assets.manifest.json",
    "legacyReceipt": "file-viewer-copy-assets.receipt.json",
    "ownerLedger": "file-viewer-assets.ledger.json",
    "requirements": [
      "runtime manifest schemaVersion remains 1",
      "asset payload bytes are equivalent across legacy, unified, alias, and full-package entrypoints",
      "integrity metadata is stable on an idempotent merge",
      "adding owner receipts or the owner ledger is backward compatible"
    ]
  },
  "incrementalAndConflictPolicy": {
    "defaultMode": "transactional merge",
    "preserveUnrelatedFiles": true,
    "identicalUnownedFile": "keep and record as shared",
    "differentUnownedFile": "fail without overwriting",
    "modifiedManagedFile": "fail without overwriting",
    "rendererSubsetMerge": "union copy groups without deleting earlier groups",
    "idempotentRepeat": "do not rewrite receipts or manifests"
  },
  "securityPolicy": {
    "cleanRequires": ["--clean", "--confirm"],
    "cleanTargetBasename": "file-viewer",
    "forbiddenCleanTargets": [
      "filesystem root",
      "current working directory",
      "home directory",
      "non-file-viewer directory"
    ],
    "rejectPathTraversal": true,
    "rejectSymbolicLinkTargetOrDescendant": true,
    "transactionalRollback": true
  },
  "legacyFullRendererIds": [
