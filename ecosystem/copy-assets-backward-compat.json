  "registryReleaseGate": {
    "package": "file-viewer-copy-assets",
    "historicalRegression": {
      "version": "2.4.0",
      "observedFailure": "The machine-default https://registry.npmmirror.com mirror temporarily returned E404 or ETARGET during the v3 release rehearsal.",
      "statusAtContractCreation": "The authoritative https://registry.npmjs.org/ resolves 2.4.0; official-registry truth and mirror propagation must be reported separately."
    },
    "candidateRequirements": [
      "exact package version resolves from the production npm registry",
      "standalone CLI cold-installs and copies the full legacy matrix",
      "every full package cold-installs with the exact same-version dependency",
      "installed full-package file-viewer-copy-assets bin copies the full legacy matrix"
    ]
  },
  "documentation": {
